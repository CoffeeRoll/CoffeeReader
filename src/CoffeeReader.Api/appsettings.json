{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "LibraryPath": "/books",
    "DataPath": "/config",
    "UploadFolder": "Uploads"
  },
  "LibraryScan": {
    "ScanOnStartup": true,
    "WatchForChanges": true,
    "IntervalMinutes": 60,
    "DebounceSeconds": 5
  },
  "Uploads": {
    "MaxFileSizeMb": 512
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false
  }
}
